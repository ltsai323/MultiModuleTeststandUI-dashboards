          "rawQuery": true,
          "rawSql": "WITH\n\tLATEST_STAGES AS (\n\t\tSELECT DISTINCT\n\t\t\tON (SPLIT_PART(COMMENT, '-', 1)) SPLIT_PART(COMMENT, '-', 1) AS STAGE,\n\t\t\tCOMMENT,\n\t\t\tTO_DATE(SPLIT_PART(COMMENT, '-', 2), 'YYYYMMDD') AS TEST_DATE\n\t\tFROM\n\t\t\tPUBLIC.MODULE_IV_TEST\n\t\tWHERE\n\t\t\tCOMMENT ~ '^stage[1-4]-[0-9]{8}$'\n\t\tORDER BY\n\t\t\tSPLIT_PART(COMMENT, '-', 1),\n\t\t\tTO_DATE(SPLIT_PART(COMMENT, '-', 2), 'YYYYMMDD') DESC\n\t)\n\nSELECT comment AS stageID, stage, test_date FROM latest_stages\nORDER BY\ntest_date DESC\nLIMIT 60;",
