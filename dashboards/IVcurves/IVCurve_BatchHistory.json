          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH\n\tFILTERED_IV AS (\n\t\tSELECT\n\t\t\tM.*,\n\t\t\tM.MEAS_I[ARRAY_LENGTH(M.MEAS_I, 1)] AS I_LAST\n\t\tFROM\n\t\t\tMODULE_IV_TEST AS M\n\t\t\tWHERE M.COMMENT = '${stageID}'\n\t),\n\tUNNESTED AS (\n\t\tSELECT\n\t\t\tMODULE_NAME,\n\t\t\tABS(V) AS ABSV,\n\t\t\tI,\n\t\t\t(DATE_TEST + TIME_TEST) AS TESTTIMESTAMP\n\t\tFROM\n\t\t\tFILTERED_IV,\n\t\t\tUNNEST(PROGRAM_V, MEAS_I) AS T (V, I) -- use program_v instead of meas_v since the case 0 volt from keithley hits compliance.\n\t)\nSELECT\n\tMODULE_NAME,\n\tABSV,\n\tI\nFROM\n\tUNNESTED\nWHERE\n\tABSV != 0 -- voltage=0 means module hits compliance current\nORDER BY\n\tTESTTIMESTAMP,\n\tRIGHT(MODULE_NAME, 4) ASC,\n\tABSV ASC;",
          "refId": "A",
          "sql": {
