          "dataset": "hgcdb",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mac_postgres_db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH all_modules AS (\nSELECT DISTINCT (module_name)\nFROM public.module_info\nWHERE module_name LIKE '320%'\n),\n     val AS (\nSELECT module_name, (date_encap+time_encap) AS encapsulate_time, cure_start, cure_end, temp_c AS temperature, rel_hum AS humidity\nFROM public.front_encap\nWHERE module_name LIKE '320%'\n)\nSELECT\nkeys.module_name,\nval.encapsulate_time,\nval.cure_start,\nval.cure_end,\nval.temperature,\nval.humidity\nFROM all_modules AS keys\nLEFT JOIN val ON (keys.module_name = val.module_name)\n\n\nORDER BY RIGHT(keys.module_name,4) DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Frontside encapsulations",
      "type": "table"
    }
